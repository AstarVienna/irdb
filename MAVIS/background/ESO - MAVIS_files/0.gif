<script>
	$(document).ready(function() {

		$('#logout').click(function() {
			//Use JQuery AJAX request to post data to the ESO Logout Servlet
			$.ajax({
				type: 'POST',
				url:'/public/login.esologout.html',
				data:'',
				success: function(data){
					setTimeout(function(){
						location.reload();
					}, 1000);
				}
			});
		});

	}); // end ready
</script>

